@prefix onb: <https://mapsofmaking.org/ns/onboarding#> .
@prefix : <https://mapsofmaking.org/onboarding/space-coordinator#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .

# The home app's tile tree (home.mapsofmaking.org, Epic 14). Single source of every
# line Bernard speaks in the app, and of tile A's own words (14.2 AC8): another
# vertical forks the app by swapping this file.
# Draft vocabulary: onb: moves to the ontology repo once stable. The doneWhen queries
# are illustrative: they show how an app would read progress from the pod; their
# predicates are not settled. Copy reference: the "Onboard Storyboard" design canvas.
# onb:lead is the app's own voice, not Bernard's: a tile's plain opening line (tile A has no guide yet);
# onb:leadShort is the same on a phone. onb:ui* lines and onb:field nodes are the app's own
# words on a tile (labels, hints, buttons, messages); Bernard's lines are onb:say*/said*.
# onb:icon names the tile's picto in the folded row (inline SVG strokes, per the design system).

# Lines that belong to the app, not to one tile.
:home a onb:App ;
  onb:sayNeedsPod "That one needs a pod I can reach with your permission. A file on GitLab can't hold it. Your call."@en .

:describe a onb:Tile ;
  onb:icon "pin" ;
  onb:title "Describe your space"@en ; onb:cue "Get on the map"@en ;
  onb:q 0 ; onb:r 0 ; onb:prio 1 ;
  onb:act "describe" ; onb:preview "mapcard" ;
  onb:lead "Maps of Making is a map of the places where people make things together: fablabs, hackerspaces, repair cafés, community workshops. Add yours. A name and a town are enough to start, and you see your card before anything goes public."@en ;
  onb:leadShort "A map of the places where people make things together. Add yours: a name and a town are enough. You see your card before anything goes public."@en ;
  onb:saidDone "Hi, I'm Bernard (they/them), from Mother Sand. That's you, the way a visitor will see it. For now it only lives in this browser. Nobody else can see it."@en ;
  onb:sayNext "Want it out there for real?"@en ;
  onb:uiSeeMap "See the map ↗"@en ;
  onb:uiOptional "Optional · change it any time"@en ;
  onb:uiMore "Add more: description, contact, website, logo"@en ;
  onb:uiCta "Show me my card"@en ;
  onb:uiExample "Fill in an example"@en ;
  onb:uiStartOver "Start over"@en ;
  onb:uiStartOverAsk "This clears everything typed here, in this browser."@en ;
  onb:uiClear "Clear it"@en ;
  onb:uiKeepIt "Keep it"@en ;
  onb:uiCleared "Cleared. Nothing typed is kept in this browser."@en ;
  onb:uiFix "Fix something first"@en ;
  onb:uiChange "Change something"@en ;
  onb:uiNotOnPod "This step isn't connected to your pod yet, so nothing was saved or marked done."@en ;
  onb:uiPinWorking "Working out where that is."@en ;
  onb:uiPinFound "Dropping the pin here:"@en ;
  onb:uiPinByHand "Pin set by hand:"@en ;
  onb:uiStreetMissed "No match for the street, so the pin sits in the centre of {city}."@en ;
  onb:uiNoResult "The geocoder (OpenStreetMap) can't place that. Check the city, or enter the coordinates below."@en ;
  onb:uiUnavailable "The geocoder isn't answering right now. Enter the coordinates below, or leave the city field again in a moment."@en ;
  onb:uiRate "Too many requests to the geocoder. Wait a moment, then leave the city field again."@en ;
  onb:uiAddedScheme "Added https://. Change it if that's wrong."@en ;
  onb:uiAddedRoom "Added # for a room. Change it to + if it's a community."@en ;
  # The form's fields, in no order (the code orders them). onb:example fills "Fill in an
  # example": a space that doesn't exist, so nothing typed is mistaken for real. Its street
  # doesn't exist either: the pin falls back to the Marolles, and the pin line says so.
  onb:field
    [ onb:key "name" ; onb:label "Space name"@en ; onb:placeholder "The name your community knows"@en ;
      onb:hint "Tab or Enter to move on."@en ; onb:example "Weld Done" ] ,
    [ onb:key "street" ; onb:label "Street address"@en ; onb:placeholder "e.g. Rue du Canal 12"@en ;
      onb:hint "Optional. Without it, the pin sits in the town's centre."@en ; onb:example "Rue de l'Étincelle 12" ] ,
    [ onb:key "city" ; onb:label "City"@en ; onb:hint "The town or municipality."@en ; onb:example "Marolles, Bruxelles" ] ,
    [ onb:key "description" ; onb:label "Description"@en ; onb:placeholder "One or two sentences. What kind of space is this?"@en ;
      onb:example "Metal shop with two welding stations. Gloves provided, sparks included."@en ] ,
    [ onb:key "email" ; onb:label "Contact email"@en ; onb:placeholder "hello@example.org"@en ;
      onb:hint "Not a personal inbox. Somewhere the space can be reached."@en ; onb:example "hello@welddone.example" ] ,
    [ onb:key "matrix" ; onb:label "Matrix room"@en ; onb:placeholder "#yourspace:matrix.org"@en ;
      onb:hint "The space's room, not a personal account."@en ; onb:example "#welddone:matrix.org" ] ,
    [ onb:key "website" ; onb:label "Website"@en ; onb:placeholder "example.org"@en ;
      onb:hint "The space's main web page."@en ; onb:example "https://welddone.example" ] ,
    [ onb:key "logo" ; onb:label "Logo URL"@en ; onb:placeholder "example.org/logo.png"@en ;
      onb:hint "Transparent PNG works best."@en ] ,
    [ onb:key "country" ; onb:label "Country code"@en ; onb:placeholder "e.g. BE"@en ;
      onb:hint "Two letters, ISO. e.g. DE, FR, BE."@en ] ,
    [ onb:key "lat" ; onb:label "Latitude"@en ; onb:placeholder "e.g. 50.84"@en ] ,
    [ onb:key "lon" ; onb:label "Longitude"@en ; onb:placeholder "e.g. 4.33"@en ] ;
  onb:doneWhen """ASK { ?space a mom:Space ; schema:name ?n ; schema:address ?a }""" .

:keep a onb:Tile ;
  onb:icon "publish" ;
  onb:title "Publish it"@en ; onb:cue "Out there for real"@en ;
  onb:q 1 ; onb:r 0 ; onb:prio 2 ;
  onb:requiresAll :describe ;
  onb:act "threshold" ; onb:preview "kept" ; onb:unlocksWord :pod ;
  onb:say "Your data needs a home online, a public place the map can read from. Two ways: do it yourself, or let us. Your choice."@en ;
  onb:saidDone "There you are. Anyone looking for a workshop in {locality} can find you now."@en ;
  onb:sayNext "That's the hard part done. But hours change, stuff happens: when something's different, update it once. Here, or later at home.mapsofmaking.org."@en ;
  onb:sayPod "Three things: a name for your Personal Online Datastore (pod), the space's mailbox and a passphrase to secure it."@en ;
  onb:sayConsent "Your pod opens its own page now. If it asks for your passphrase, use the one you just made. Then press Authorize for home.mapsofmaking.org."@en ;
  onb:sayTaken "The pod server said that address is taken. Nothing you did wrong. Pick another one."@en ;
  onb:saidDoneSelf "You've got the file. Now it needs an address. Some use GitLab, it gives you one, free, in about five minutes."@en ;
  # Tile B's own words (14.3): the two doors, the real "not now", and what the pod server's answer changes.
  onb:uiDoorSelf "Take the file, look after it yourself"@en ;
  onb:uiDoorPod "We look after it, you hold the key"@en ;
  onb:uiNotNow "Not now"@en ;
  onb:uiNotNowSaid "Fine too. It stays in this browser until you clear it. Nothing was sent."@en ;
  onb:uiDoorsAgain "Look at the two ways again"@en ;
  onb:uiChecking "Asking the pod server what it offers."@en ;
  onb:uiNoRegister "This pod server isn't taking new accounts right now. You can still look after the file yourself."@en ;
  onb:uiProviderDown "I can't reach the pod server just now. Nothing was sent. Try again in a moment, or look after the file yourself."@en ;
  onb:uiTryAgain "Try again"@en ;
  onb:uiSelfSoon "Looking after the file yourself opens soon. If you already host a space file, you can add it on the map."@en ;
  onb:uiSelfSoonLink "Go to the map ↗"@en ;
  # The doors' own lines (storyboard B1), and the pod form (B2; S2 of 14.3). The form says "passphrase" everywhere (14.0).
  onb:uiDoorSelfDesc "Put it anywhere public: your website, or a Git repo. The map reads it from there. You change it by editing the file as you see fit."@en ;
  onb:uiDoorPodDesc "Kept at Maps of Making under your space's name. You get tools that help you run your space."@en ;
  onb:uiDoorSelfWhere "any public address"@en ;
  onb:uiDoorsNote "Your profile stays as you described it, nothing to retype. You can switch later: the map only needs to know where the data lives."@en ;
  onb:uiPodAddress "Your space's address"@en ;
  onb:uiPodEmail "Email"@en ;
  onb:uiPodEmailHint "The space's mailbox, not yours. Whoever holds it can reset the passphrase, so the space can change hands."@en ;
  onb:uiPodPass "Passphrase"@en ;
  onb:uiPodPassAgain "Same again"@en ;
  onb:uiPodPassExample "Rock-Paper-Scissors-Lizard-Spock"@en ;
  onb:uiPodPassHint "Eight characters or more, no spaces. A few ordinary words joined by dashes beat one clever password."@en ;
  onb:uiPodShow "Show"@en ;
  onb:uiPodHide "Hide"@en ;
  onb:uiPodShowLabel "Show the passphrase"@en ;
  onb:uiPodHideLabel "Hide the passphrase"@en ;
  onb:uiPodCreate "Create it"@en ;
  onb:uiPodOtherDoor "Take the other door"@en ;
  onb:uiPodCreating "Creating your pod. This takes a few seconds."@en ;
  onb:uiPodCreated "Your pod is ready: {address}. Opening its page to sign you in."@en ;
  onb:uiSignIn "Sign in"@en ;
  onb:uiSignInFailed "Your pod exists at {address}, but signing in didn't start. Press Sign in to try again."@en ;
  # Back from the pod's own page, signed in (14.3 AC6). Wording to settle with Nicolas (story, open question 1).
  onb:uiPodReadyAt "Your pod"@en ;
  onb:saidPodReady "You're signed in, and the pod is yours. Nothing is in it yet: your card still lives in this browser. Putting it there comes next."@en ;
  # What the pod server said, each with one way forward (14.3 AC5). Red only for errors (the field's border).
  onb:uiTakenLabel "Address taken"@en ;
  onb:uiTakenTry "Taken. Try {suggestion}."@en ;
  onb:uiTakenPick "Taken. Pick another one."@en ;
  onb:uiEmailTaken "An account already uses this email. Use another mailbox, or log in at the pod with this one."@en ;
  onb:uiEmailKept "The account already has this email. Only the address can change now."@en ;
  onb:uiPassRefused "The pod server refused this passphrase. Try a longer one, without spaces."@en ;
  onb:uiUnreachable "The pod server isn't answering. Press Create it again in a moment."@en ;
  onb:uiUnclear "The pod server's answer wasn't readable, so I can't tell whether anything was made. Wait a minute, then sign in at the pod with your email, or press Create it again."@en ;
  onb:uiResumeFailed "The account started here can't be continued. Sign in at the pod with your email and passphrase, or use another email."@en ;
  # A pod made in this tab and not signed in to yet: the way back is a sign-in, not a second account (14.3 review).
  onb:uiPriorPod "You made a pod here: {address}. Sign in to it."@en ;
  onb:uiPriorSignIn "Sign in to your pod"@en ;
  onb:uiPriorAnother "Make another one"@en ;
  # Signed in, with the pod made (Story 14.4): the steps of "Put it on the map", and what each says.
  onb:sayPublish "Your pod is ready. Press the button: your space's file goes in it, and anyone can read that one file. Nothing else in your pod is opened."@en ;
  onb:uiPublishGo "Put it on the map"@en ;
  onb:uiStepFile "Write your space's file in your pod"@en ;
  onb:uiStepFileWorking "Writing it."@en ;
  onb:uiStepFileWritten "Written, and read back: {address}"@en ;
  onb:uiStepFileThere "It was already there and says the same. Left as it is."@en ;
  onb:uiStepFileKept "A file is already there and says something else. Left exactly as it is, so your edits stay."@en ;
  onb:uiStepMap "Put it on the map"@en ;
  onb:uiStepMapWorking "The map is reading your file."@en ;
  onb:uiStepMapDone "The map has it."@en ;
  onb:uiMapRefused "The map read your file and didn't take it. Check the description in the first tile, then press again."@en ;
  onb:uiMapDown "The map isn't answering right now. Your file is in your pod and public: press again in a moment."@en ;
  onb:uiOnMapLive "On the map, live"@en ;
  onb:uiPinLate "The map is still drawing your pin. It shows there in a minute."@en ;
  onb:uiFileAddress "Your space's file"@en ;
  onb:uiCopy "Copy the address"@en ;
  onb:uiCopied "Copied."@en ;
  onb:uiSeeOnMap "See it on the map ↗"@en ;
  onb:uiStepPublic "Let anyone read it"@en ;
  onb:uiStepPublicWorking "Opening that one file to anyone."@en ;
  onb:uiStepPublicDone "Anyone can read it now: checked without signing in. Nothing else in your pod was opened."@en ;
  onb:uiStepPublicAlready "Anyone could already read it, and it's checked without signing in. Left as it is."@en ;
  onb:uiPublicUnknown "Who can read this file is set by rules this app doesn't understand, so they were left alone. The people who run the pod server can help."@en ;
  onb:uiPublicNotPublic "The file is open to anyone, but reading it without signing in still fails ({status}). Press the button again."@en ;
  onb:uiPublicBlocked "The file was already open to anyone, yet reading it without signing in fails ({status}). Pressing again won't change that: the people who run the pod server can see why."@en ;
  onb:uiPublicWider "Anyone can already change this file, not only read it. That was left alone: check who can edit it in your pod before putting it on the map."@en ;
  onb:uiPublicNoControl "This account can read and write the file but can't decide who reads it. The pod's owner can open it to anyone."@en ;
  onb:uiPublicConflict "Who can read the file changed while this ran. Press the button again: it starts from what is there now."@en ;
  onb:uiPublicGone "The file is no longer in your pod. Press the button again: it is written anew."@en ;
  onb:uiPublicNoWac "This pod server sets who can read files another way, which this app doesn't handle yet. The people who run it can help."@en ;
  onb:uiPublishDropped "Left out of the file, because it isn't a web address: {fields}."@en ;
  onb:uiPublishIncomplete "Your description isn't complete: it still needs {missing}. Go back to the first tile, then press again."@en ;
  onb:uiMissingName "a name"@en ;
  onb:uiMissingTown "a town"@en ;
  onb:uiMissingCountry "a country"@en ;
  onb:uiMissingPin "a pin on the map"@en ;
  onb:uiPublishExpired "Your session ended. Sign in again, then press Put it on the map: it continues where it stopped."@en ;
  onb:uiPublishUnreachable "The pod isn't answering. Press the button again in a moment."@en ;
  onb:uiPublishRefused "Your pod said no ({status}). Press the button again; if it keeps saying no, the people who run the pod server can see why."@en ;
  onb:uiPublishUnreadable "The pod took the file but holds it differently than it was written. Press the button again."@en ;
  onb:uiBusy "Too many tries from this connection. Wait a while, then press Create it again."@en ;
  onb:uiBusyMinutes "Too many tries from this connection. Press Create it again in about {minutes} minutes."@en ;
  onb:uiBusyMinute "Too many tries from this connection. Press Create it again in a minute."@en ;
  onb:uiHalfDone "Your account exists, but the pod isn't made yet. Press Create it again: it continues where it stopped."@en ;
  onb:uiProviderSaid "The pod server said no: {detail}. Nothing you did wrong. Try again, or take the other door."@en ;
  onb:uiAddrEmpty "Pick an address for your space."@en ;
  onb:uiAddrBad "Lower-case letters, numbers and dashes only, and no dash at the start or the end."@en ;
  onb:uiAddrLong "An address can be 63 characters at most. Shorter, please."@en ;
  onb:uiEmailBad "That doesn't look like an email address."@en ;
  onb:uiPassShort "Eight characters or more."@en ;
  onb:uiPassSpace "No spaces. Dashes between words work."@en ;
  onb:uiPassMismatch "The two don't match."@en ;
  onb:doneWhen """ASK { <> pim:storage ?pod }  # or: the map knows the space's own URL""" .

:change a onb:Tile ;
  onb:icon "pencil" ;
  onb:title "Update it once"@en ; onb:cue "One edit, everywhere"@en ;
  onb:q 2 ; onb:r -1 ; onb:prio 3 ;
  onb:requiresAll :keep ;
  onb:act "hours" ; onb:preview "readers" ; onb:unlocksWord :endpoint ;
  onb:say "Hours change. Change them here. Once."@en ;
  onb:saidDone "One edit, in your file. The map reads it from there: nothing to retype anywhere else."@en ;
  onb:sayTool "Your profile, as the map reads it. Change what's changed."@en ;
  onb:saidSaved "Saved once, in your file. The map picks it up from there."@en ;
  onb:uiHoursLabel "Opening hours"@en ;
  onb:uiHoursHint "Change anything. Winter hours, a holiday, a new evening. Only this line of your file changes."@en ;
  onb:uiHoursPlaceholder "Tu-Sa 10:00-18:00"@en ;
  onb:uiSave "Save the change"@en ;
  onb:uiHoursFirst "This first time, only the hours."@en ;
  onb:uiSaving "Writing it to your file."@en ;
  onb:uiHoursSame "That's what your file already says. Nothing was written."@en ;
  onb:uiHoursEmpty "Write the hours first: an empty line can't go in the file."@en ;
  onb:uiHoursConflict "Your file changed since this page read it, maybe from the backoffice. Nothing was written. Press Save again: it reads the file afresh, and what you typed stays."@en ;
  onb:uiHoursExpired "Your session ended. Sign in again, then write the hours once more and press Save: nothing was written."@en ;
  onb:uiHoursGone "Your space's file isn't on the pod any more. Publish it again from the tile before this one."@en ;
  onb:uiHoursUnreachable "The pod isn't answering. Press Save again in a moment."@en ;
  onb:uiHoursRefused "Your pod said no. Press Save again; if it keeps saying no, the people who run the pod server can see why."@en ;
  onb:uiHoursUnreadable "The pod took the hours but the file doesn't say them back. Press Save again."@en ;
  onb:uiHoursWas "was {was}."@en ;
  onb:uiHoursNew "Your file had no opening hours. It has now."@en ;
  onb:uiFileLabel "Your file"@en ;
  onb:uiFileFrom "read from your pod"@en ;
  onb:uiStepWritten "Written to your pod"@en ;
  onb:uiStepMapReading "The map is reading it"@en ;
  onb:uiStepMapReadingWhy "This app asks the map to read it now, not at its next round."@en ;
  onb:uiStepMapRead "The map read it"@en ;
  onb:uiStepMapLate "It took the file; the card catches up within a minute."@en ;
  onb:uiMapDidntRead "The map didn't answer. Your file has the hours; press the button to ask the map again."@en ;
  onb:uiMapRefusedFile "The map read your file and didn't take it. Your file has the hours; the people who run the map can see why."@en ;
  onb:uiMapAgain "Ask the map again"@en ;
  onb:uiCardLabel "Your card on the map"@en ;
  onb:uiCardFacts "Open the profile, and it shows"@en ;
  onb:uiAddressFact "Address"@en ;
  onb:uiHoursFact "Hours"@en ;
  onb:uiBackToTiles "Back to your tiles"@en ;
  onb:uiTileStays "This tile is done. It stays your shortcut for the next change."@en ;
  onb:uiReloadHint "Map open in another tab? Reload it to see the change."@en ;
  # The logo (14.6 S6, #41): shown once the hours are in the file. No SVG until the pod site sandboxes uploads.
  onb:uiLogoLabel "Logo"@en ;
  onb:uiLogoUpload "Upload a logo"@en ;
  onb:uiLogoHint "PNG, JPEG or WebP, up to 512 KB. It goes next to your space's file, and anyone can see it: it's on your card."@en ;
  onb:uiLogoOr "Or one already online:"@en ;
  onb:uiLogoPlaceholder "https://…"@en ;
  onb:uiLogoUseAddress "Use this address"@en ;
  onb:uiLogoSaving "Putting it on your pod."@en ;
  onb:uiLogoSaved "Your file points at it now."@en ;
  onb:uiLogoReplaced "Replaced, at the same address: your file didn't need to change. Map open in another tab? Reload it."@en ;
  onb:uiLogoSame "That's the address your file already says. Nothing was written."@en ;
  onb:uiLogoTooLarge "That image is over 512 KB. Pick a smaller one: nothing was written."@en ;
  onb:uiLogoNotImage "That isn't a PNG, JPEG or WebP image. Nothing was written."@en ;
  onb:uiLogoBadAddress "That isn't a web address. It starts with https://."@en ;
  onb:uiLogoTaken "A file called logo is already next to your space's file, and your space doesn't use it. Nothing was written. Rename it in the backoffice, then try again."@en ;
  onb:uiLogoNotPublic "The logo is on your pod, but a stranger can't read it yet, so your file doesn't point at it. Press again."@en ;
  onb:uiLogoExpired "Your session ended. Sign in again, then upload it once more."@en ;
  onb:uiLogoNoAccess "Your pod says this account can't write there. Signing in again won't help: check who can edit it in the backoffice."@en ;
  onb:uiLogoConflict "Your file changed since this page read it. Press again: it reads the file afresh."@en ;
  onb:uiLogoUnreachable "The pod isn't answering. Try again in a moment."@en ;
  onb:uiLogoRefused "Your pod said no. Try again; if it keeps saying no, the people who run the pod server can see why."@en ;
  onb:uiLogoUnconfirmed "The logo went in, but reading your file back didn't work. Press again: if it's there, nothing more is written."@en ;
  onb:uiLogoMapReading "The map is reading it."@en ;
  onb:uiLogoMapRead "The map shows it."@en ;
  onb:uiLogoMapLate "The map took it; the card catches up in a moment."@en ;
  onb:uiLogoMapDidntRead "The map didn't answer. Your file points at the logo; the map picks it up at its next read."@en ;
  # A space that moves (14.6 S5, #40): shown once the hours are in the file. Placed by the geocoder first, then
  # the address and the pin are written together, or neither.
  onb:uiMoveLabel "Where the space is"@en ;
  onb:uiMoveHint "Moved? Type the new address. It's placed on the map first, then written with the pin, together."@en ;
  onb:uiMoveStreet "Street address"@en ;
  onb:uiMoveCity "City"@en ;
  onb:uiMoveSave "Move the pin"@en ;
  onb:uiMoveEmpty "Type at least the city. Nothing was written."@en ;
  onb:uiMoveFinding "Looking for the new address"@en ;
  onb:uiMoveFound "Found the new address: {place}"@en ;
  onb:uiMoveStreetMissed "No match for the street, so the pin sits in the centre of {city}."@en ;
  onb:uiMoveNoPlace "The geocoder (OpenStreetMap) can't place that address. Nothing was written: check the street and the city."@en ;
  onb:uiMoveRate "Too many requests to the geocoder. Nothing was written: press again in a moment."@en ;
  onb:uiMoveUnavailable "The geocoder (OpenStreetMap) isn't answering. Nothing was written: try again in a moment."@en ;
  onb:uiMoveWriting "Writing it to your pod"@en ;
  onb:uiMoveWritten "Written to your pod"@en ;
  onb:uiMoveDone "Street address was {was}. The pin moved with it."@en ;
  onb:uiMoveSame "That's where your file already says the space is. Nothing was written."@en ;
  onb:uiMoveExpired "Your session ended. Sign in again, then press Move the pin once more."@en ;
  onb:uiMoveNoAccess "Your pod says this account can't change the file. Signing in again won't help: check who can edit space.ttl in the backoffice."@en ;
  onb:uiMoveConflict "Your file changed since this page read it. Press again: it reads the file afresh."@en ;
  onb:uiMoveGone "Your space's file isn't on your pod any more. Nothing was written."@en ;
  onb:uiMoveUnreachable "The pod isn't answering. Nothing was written: try again in a moment."@en ;
  onb:uiMoveRefused "Your pod said no. Try again; if it keeps saying no, the people who run the pod server can see why."@en ;
  onb:uiMoveUnreadable "Your file doesn't hold one address and one pin this page can change. Nothing was written: edit it in the backoffice."@en ;
  onb:uiMoveUnconfirmed "The move went to your file, but reading it back didn't work. Press again: if the file says it, nothing more is written."@en ;
  onb:uiHoursNoAccess "Your pod says this account can't change the file. Signing in again won't help: check who can edit space.ttl in the backoffice."@en ;
  onb:uiHoursUnconfirmed "The hours went to your file, but reading it back didn't work. Press Save again: if the file says them, nothing more is written."@en ;
  onb:uiProfileTitle "Your space's file"@en ;
  onb:uiProfileLead "Everything the map shows about your space, from your file. Change what you want; it is written in one go."@en ;
  onb:uiProfileLoading "Reading your file."@en ;
  onb:uiProfileLoadFailed "Your file couldn't be read, so nothing can be changed from here. Reload to try again."@en ;
  onb:uiProfileFind "Find a field"@en ;
  onb:uiProfileFindPlaceholder "Find a field or something it says"@en ;
  onb:uiProfileFindCount "{n} found"@en ;
  onb:uiProfileFindNone "Nothing in your file matches that."@en ;
  onb:uiProfileEmpty "empty"@en ;
  onb:uiProfileCard "Your card"@en ;
  onb:uiProfileNotSaved "Not saved yet"@en ;
  onb:uiProfileSaved "As saved"@en ;
  onb:uiProfileSave "Save"@en ;
  onb:uiProfileNothing "Nothing changed yet."@en ;
  onb:uiProfileChangeOne "1 change"@en ;
  onb:uiProfileChangeMany "{n} changes"@en ;
  onb:uiProfilePinMoves "The pin moves with it."@en ;
  onb:uiProfileStreet "Street address"@en ;
  onb:uiProfileCity "City"@en ;
  onb:uiProfileAddHandle "Add a contact"@en ;
  onb:uiProfileRemoveHandle "Remove"@en ;
  onb:uiProfileHandleKind "Kind of contact"@en ;
  onb:uiProfileHandleValue "Contact"@en ;
  onb:uiProfileFix "Fix it"@en ;
  onb:uiProfileFixing "{was} becomes {fixed}"@en ;
  onb:uiProfileNeedsFix "Needs a fix"@en ;
  onb:uiProfileWhySpaces "Spaces at the start or end."@en ;
  onb:uiProfileWhyCase "The case isn't the usual one."@en ;
  onb:uiProfileWhyAsText "Held as plain text where an address belongs."@en ;
  onb:uiProfileWhyScheme "The address has no https:// in front."@en ;
  onb:uiProfileWhyPrefix "A prefix the file doesn't need."@en ;
  onb:uiProfileWhyRoom "Not a Matrix room this page can link to."@en ;
  onb:uiProfileWhyHandle "Not a handle: letters, digits and underscores, five or more."@en ;
  onb:uiProfileWhyEmpty "This is empty."@en ;
  onb:uiProfileWhyEmail "Not an email address."@en ;
  onb:uiProfileWhyPhone "A phone number needs its country code, like +32 2 123 45 67."@en ;
  onb:uiProfileWhyAddress "Not a web address this file can carry."@en ;
  onb:uiProfileWhyCity "A city is needed to place the pin."@en ;
  onb:uiProfileWhyCountry "A country is needed."@en ;
  onb:uiProfileWhyPin "The pin isn't a place on Earth."@en ;
  onb:uiProfileAddressProblem "The file doesn't hold one address and one pin this page can change. Edit it in the backoffice."@en ;
  onb:uiProfileOthers "Other things in your file"@en ;
  onb:uiProfileOthersHint "Another writer put these there. This page shows them and leaves them alone."@en ;
  onb:uiProfileUnconfirmed "The change went to your file, but reading it back didn't work. Press Save again: if the file says it, nothing more is written."@en ;
  onb:uiProfileSame "Your file already says all of this. Nothing was written."@en ;
  onb:uiProfileDone "Written, and read back from your pod."@en ;
  onb:uiProfileMany "Your file holds more than one value here. This page leaves them as they are: change them in the backoffice."@en ;
  onb:uiProfileChangedSince "Your file changed since this page read it, so it was read again. What you typed was not written: nothing of what is there was overwritten."@en ;
  onb:doneWhen """ASK { ?space schema:openingHours ?h }  # tile A doesn't ask for hours: present means set here, or by the coordinator's own edit (decided 2026-11-03)""" .

:join a onb:Tile ;
  onb:icon "people" ;
  onb:title "Join your network"@en ; onb:cue "Show who you belong to"@en ;
  onb:q 2 ; onb:r 0 ; onb:prio 4 ;
  onb:requiresAll :keep ; onb:needsPod true ;
  onb:act "network" ; onb:preview "network" ; onb:unlocksWord :handshake ;
  onb:say "Name your network. I carry the request. They answer, not me."@en ;
  onb:saidDone "Request's in their inbox. Dashed until they say yes. Solid after. Either of you can end it, any day, without asking."@en ;
  onb:doneWhen """ASK { ?space org:memberOf ?network }""" .

:event a onb:Tile ;
  onb:icon "calendar" ;
  onb:title "Post an event"@en ; onb:cue "Tell people what's on"@en ;
  onb:q 1 ; onb:r 1 ; onb:prio 5 ;
  onb:requiresAll :keep ;
  onb:act "event" ; onb:preview "mapcard" ;
  onb:say "A title and a date. It goes on your card."@en ;
  onb:saidDone "On your card. Posted once."@en ;
  onb:doneWhen """ASK { ?event a schema:Event ; schema:location ?space }""" .

:answer a onb:Tile ;
  onb:icon "speech" ;
  onb:title "Let it answer for you"@en ; onb:cue "Stop answering the same question"@en ;
  onb:q 3 ; onb:r -2 ; onb:prio 6 ;
  onb:requiresAll :change ; onb:needsPod true ;
  onb:act "none" ; onb:preview "assistant" ; onb:unlocksWord :agent ;
  onb:say "Same questions every week. Give an assistant your folder. That folder, nothing else."@en ;
  onb:saidDone "It read one file. The log says which, and when. That's the deal."@en ;
  onb:doneWhen """ASK { ?agent solid:owner <> . ?acl acl:agent ?agent ; acl:accessTo ?folder }""" .

:second a onb:Tile ;
  onb:icon "layers" ;
  onb:title "Show up on another map"@en ; onb:cue "More maps, no extra work"@en ;
  onb:q 3 ; onb:r -1 ; onb:prio 7 ;
  onb:requiresAll :keep ;
  onb:act "none" ; onb:preview "ohm" ; onb:unlocksWord :linkeddata ;
  onb:say "Other maps read what I index. Say yes and you're on them. Nothing to fill twice."@en ;
  onb:saidDone "Second map. Same file."@en ;
  onb:doneWhen """ASK { ?space mom:listedOn ?otherMap }""" .

:peers a onb:Tile ;
  onb:icon "network" ;
  onb:title "Find your peers"@en ; onb:cue "See who's around you"@en ;
  onb:q 3 ; onb:r 0 ; onb:prio 8 ;
  onb:requiresAll :join ; onb:needsPod true ;
  onb:act "peers" ; onb:preview "peers" ; onb:unlocksWord :webid ;
  onb:say "The spaces your network recognises. And what they have on their benches."@en ;
  onb:saidDone "There they are. Ask before you borrow."@en ;
  onb:doneWhen """ASK { ?network org:hasMember ?space . ?space org:memberOf ?network }""" .

:agenda a onb:Tile ;
  onb:icon "agenda" ;
  onb:title "Share your events"@en ; onb:cue "On your network's calendar too"@en ;
  onb:q 2 ; onb:r 1 ; onb:prio 9 ;
  onb:requiresAll :join , :event ; onb:needsPod true ;
  onb:act "none" ; onb:preview "agenda" ;
  onb:say "Your events on the network's calendar. You don't post twice."@en ;
  onb:saidDone "Beside your peers'. Posted once, still."@en ;
  onb:doneWhen """ASK { ?event mom:sharedWith ?network }""" .

:discord a onb:Tile ;
  onb:icon "chat" ;
  onb:title "Answer where people talk"@en ; onb:cue "On Discord or Matrix too"@en ;
  onb:q 4 ; onb:r -3 ; onb:prio 10 ;
  onb:requiresAll :answer ; onb:planned true ;
  onb:say "Discord, Matrix. Where your people already talk. Not built yet."@en .

:handover a onb:Tile ;
  onb:icon "key" ;
  onb:title "Hand over the space"@en ; onb:cue "When you move on, nothing breaks"@en ;
  onb:q 1 ; onb:r 2 ; onb:prio 11 ;
  onb:requiresAll :keep ; onb:needsPod true ;
  onb:act "none" ; onb:preview "handover" ; onb:unlocksWord :account ;
  onb:say "Coordinators move on. The space stays. Give the role mailbox to whoever's next."@en ;
  onb:saidDone "Nothing breaks. The account follows the mailbox."@en ;
  onb:doneWhen """ASK { ?account mom:email ?roleMailbox }""" .

:mentor a onb:Tile ;
  onb:icon "person-plus" ;
  onb:title "Help a space join"@en ; onb:cue "Bring a neighbour"@en ;
  onb:q 4 ; onb:r -1 ; onb:prio 12 ;
  onb:requiresAll :peers ; onb:emergent true ;
  onb:say "Not drawn yet. It opens when people start doing it."@en .

:bridge a onb:Tile ;
  onb:icon "bridge" ;
  onb:title "Bridge two maps"@en ; onb:cue "Carry news between maps"@en ;
  onb:q 4 ; onb:r -2 ; onb:prio 13 ;
  onb:requiresAll :second , :peers ; onb:emergent true ;
  onb:say "Not drawn yet. A space on two maps carries things across, so nobody relays by hand."@en .

:pod a onb:Word ; onb:label "pod" ; onb:prio 1 ;
  onb:meaning "Personal Online Datastore: storage that's yours."@en .
:endpoint a onb:Word ; onb:label "endpoint" ; onb:prio 2 ;
  onb:meaning "Where your space's file can be read online. Readers come back to it for every update."@en .
:handshake a onb:Word ; onb:label "handshake" ; onb:prio 3 ;
  onb:meaning "A membership both sides state. Either side can end it at once."@en .
:agent a onb:Word ; onb:label "agent" ; onb:prio 4 ;
  onb:meaning "An assistant with a name of its own, let into the folders you choose and nowhere else."@en .
:linkeddata a onb:Word ; onb:label "linked data" ; onb:prio 5 ;
  onb:meaning "A shape other tools read without an adapter. That's how a second map finds you."@en .
:webid a onb:Word ; onb:label "WebID" ; onb:prio 6 ;
  onb:meaning "A name on the web. Each space you see has one. So does yours."@en .
:account a onb:Word ; onb:label "account" ; onb:prio 7 ;
  onb:meaning "How you sign in. Separate from your space's identity, so it can change hands."@en .

# ---- The profile (14.6 S4): what tile C's tool lists, checks and writes. A field is data: a tile or a
# network adds one by adding a node here. onb:kind says how the code reads and writes it (text, email, url,
# matrix, image, place); onb:property is the predicate on the space for a simple kind (text, email, url,
# image), and absent for matrix and place, which the code writes its own way. onb:file: where it lives.
# The contact handles: onb:shape says how the code checks one and writes its link (email, phone, matrix,
# url, at); onb:property puts it as a statement of its own on the space, onb:contactType as a
# schema:contactPoint with that type and a schema:url. The map's card shows each with its picto.
# Sections are what the Finder groups by; the names are a first guess, adjusted as the profile grows.

:basics a onb:Section ; onb:label "Basics"@en ; onb:prio 1 .
:place a onb:Section ; onb:label "Place"@en ; onb:prio 2 .
:online a onb:Section ; onb:label "Online"@en ; onb:prio 3 .
:times a onb:Section ; onb:label "Hours"@en ; onb:prio 4 .
:contact a onb:Section ; onb:label "Contact"@en ; onb:prio 5 .

:f-name a onb:ProfileField ; onb:key "name" ; onb:kind "text" ; onb:property schema:name ;
  onb:section :basics ; onb:prio 1 ; onb:required "true" ;
  onb:label "Space name"@en ; onb:hint "The name your community knows."@en .
:f-description a onb:ProfileField ; onb:key "description" ; onb:kind "text" ; onb:property schema:description ;
  onb:section :basics ; onb:prio 3 ;
  onb:label "Description"@en ; onb:hint "One or two sentences. What kind of space is this?"@en .
:f-address a onb:ProfileField ; onb:key "address" ; onb:kind "place" ;
  onb:section :place ; onb:prio 4 ; onb:required "true" ;
  onb:label "Where the space is"@en ; onb:hint "Street and town. The pin moves with the address."@en .
:f-contacts a onb:ProfileField ; onb:key "contacts" ; onb:kind "contacts" ;
  onb:section :contact ; onb:prio 7 ;
  onb:label "Contact"@en ; onb:hint "How people reach the space: one handle or many. Not personal accounts."@en .
:f-website a onb:ProfileField ; onb:key "website" ; onb:kind "url" ; onb:property schema:url ;
  onb:section :online ; onb:prio 5 ;
  onb:label "Website"@en ; onb:placeholder "example.org"@en ; onb:hint "The space's main web page."@en .
:f-logo a onb:ProfileField ; onb:key "logo" ; onb:kind "image" ; onb:property schema:logo ;
  onb:section :basics ; onb:prio 2 ;
  onb:label "Logo"@en ; onb:placeholder "example.org/logo.png"@en ; onb:hint "Transparent PNG works best."@en .
:f-hours a onb:ProfileField ; onb:key "hours" ; onb:kind "text" ; onb:property schema:openingHours ;
  onb:section :times ; onb:prio 6 ;
  onb:label "Opening hours"@en ; onb:placeholder "Tu-Sa 10:00-18:00"@en ;
  onb:hint "Change anything. Winter hours, a holiday, a new evening."@en .

:ct-email a onb:ContactType ; onb:key "email" ; onb:shape "email" ; onb:property schema:email ; onb:prio 1 ;
  onb:label "Email"@en ; onb:placeholder "hello@example.org"@en ; onb:hint "Somewhere the space can be reached, not a personal inbox."@en .
:ct-phone a onb:ContactType ; onb:key "phone" ; onb:shape "phone" ; onb:property schema:telephone ; onb:prio 2 ;
  onb:label "Phone"@en ; onb:placeholder "+32 2 123 45 67"@en ; onb:hint "With the country code."@en .
:ct-matrix a onb:ContactType ; onb:key "matrix" ; onb:shape "matrix" ; onb:contactType "Matrix" ; onb:prio 3 ;
  onb:label "Matrix"@en ; onb:placeholder "#yourspace:matrix.org"@en ; onb:hint "A room or a space, not a personal account."@en .
:ct-signal a onb:ContactType ; onb:key "signal" ; onb:shape "url" ; onb:contactType "Signal" ; onb:prio 4 ;
  onb:label "Signal"@en ; onb:placeholder "https://signal.group/#..."@en ; onb:hint "A group link."@en .
:ct-telegram a onb:ContactType ; onb:key "telegram" ; onb:shape "at" ; onb:contactType "Telegram" ; onb:linkPrefix "https://t.me/" ; onb:prio 5 ;
  onb:label "Telegram"@en ; onb:placeholder "@yourspace"@en ; onb:hint "A channel or a group."@en .
:ct-discord a onb:ContactType ; onb:key "discord" ; onb:shape "url" ; onb:contactType "Discord" ; onb:prio 6 ;
  onb:label "Discord"@en ; onb:placeholder "https://discord.gg/..."@en ; onb:hint "An invite link that doesn't expire."@en .
:ct-mattermost a onb:ContactType ; onb:key "mattermost" ; onb:shape "url" ; onb:contactType "Mattermost" ; onb:prio 7 ;
  onb:label "Mattermost"@en ; onb:placeholder "https://chat.example.org/yourspace"@en ; onb:hint "The team's or channel's address."@en .
:ct-link a onb:ContactType ; onb:key "link" ; onb:shape "url" ; onb:contactType "Link" ; onb:prio 8 ;
  onb:label "Link"@en ; onb:placeholder "https://..."@en ; onb:hint "Any other place: a forum, a newsletter, a form."@en .
